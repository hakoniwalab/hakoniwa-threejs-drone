{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/scene-config.schema.json",
  "title": "Hakoniwa Threejs Scene Config (compact)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format"],
  "anyOf": [
    { "required": ["droneTypesPath", "drones"] },
    { "required": ["vehicleTypesPath", "vehicles"] }
  ],
  "properties": {
    "version": { "type": "string" },
    "format": { "type": "string", "const": "compact" },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "model"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "type": { "enum": ["fpv-course"] },
          "pos": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "hpr": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": { "type": "number" },
          "render": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "const": "wireframe" },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "depthTest": { "type": "boolean" },
              "depthWrite": { "type": "boolean" }
            }
          }
        }
      }
    },
    "main_camera": { "type": "object" },
    "droneTypesPath": { "type": "string", "minLength": 1 },
    "drones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "droneType": { "type": "string", "minLength": 1 },
          "pos": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "hpr": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "vehicleTypesPath": { "type": "string", "minLength": 1 },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "vehicleType": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
