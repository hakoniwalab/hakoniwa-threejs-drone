{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/viewer-config.schema.json",
  "title": "Hakoniwa Threejs Viewer Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "three",
    "pdu",
    "stateInput"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "three": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneConfigPath"
      ],
      "properties": {
        "sceneConfigPath": {
          "type": "string",
          "minLength": 1
        },
        "transparentBackground": {
          "type": "boolean",
          "default": false
        },
        "droneAppearance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bodyColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "initialCameraMode": {
          "type": "string",
          "enum": ["free", "audience"],
          "default": "free"
        },
        "audienceCamera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positionM", "yawDeg", "pitchDeg", "fovDeg"],
          "properties": {
            "positionM": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number" }
            },
            "yawDeg": { "type": "number" },
            "pitchDeg": { "type": "number", "minimum": -85, "maximum": 85 },
            "fovDeg": { "type": "number", "minimum": 25, "maximum": 90 },
            "moveSpeedMps": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "pdu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pduDefPath",
        "wsUri"
      ],
      "properties": {
        "pduDefPath": {
          "type": "string",
          "minLength": 1
        },
        "wsUri": {
          "type": "string",
          "minLength": 1
        },
        "wireVersion": {
          "type": "string",
          "default": "v2"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statePanelIntervalMsec": {
          "type": "integer",
          "minimum": 1
        },
        "enableAttachedCameras": {
          "type": "boolean",
          "default": true
        },
        "enableMainCameraMouseControl": {
          "type": "boolean",
          "default": true
        },
        "attachedCameraPresentation": {
          "type": "string",
          "enum": ["overlay", "main"],
          "default": "overlay"
        }
      }
    },
    "faultInjection": {
      "type": "object",
      "description": "Rotor fault and wind injection through the Drone disturbance PDU.",
      "additionalProperties": false,
      "required": ["robotName", "rotorCount"],
      "properties": {
        "robotName": {
          "type": "string",
          "minLength": 1
        },
        "pduName": {
          "type": "string",
          "minLength": 1,
          "default": "disturb"
        },
        "rotorCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "flightPaths": {
      "type": "array",
      "description": "Planned Drone flight paths drawn on request (DroneViewer.setFlightPathsVisible). Points are Urban ENU metres: the scene's X = east_m, Y = up_m, Z = -north_m.",
      "items": {
        "type": "object",
        "required": ["points"],
        "properties": {
          "drone": { "type": "string" },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["east_m", "north_m", "up_m"],
              "properties": {
                "east_m": { "type": "number" },
                "north_m": { "type": "number" },
                "up_m": { "type": "number" },
                "kind": { "enum": ["takeoff", "waypoint", "land"] },
                "label": { "type": "string" },
                "name": { "type": "string" },
                "stand": { "type": "boolean" },
                "again": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "routePaths": {
      "type": "array",
      "description": "Planned vehicle routes drawn with the flight paths (DroneViewer.setPlannedPathsVisible): points in Urban ENU metres, dense enough to follow the ground (bridges, slopes).",
      "items": {
        "type": "object",
        "required": ["points"],
        "properties": {
          "route": { "type": "string" },
          "vehicles": { "type": "array", "items": { "type": "string" } },
          "closed": { "type": "boolean" },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["east_m", "north_m", "up_m"],
              "properties": {
                "east_m": { "type": "number" },
                "north_m": { "type": "number" },
                "up_m": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "stateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "legacy",
            "fleets",
            "none"
          ]
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roleMap"
          ],
          "properties": {
            "motorChannels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            },
            "rotorScale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "roleMap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pos",
                "motor"
              ],
              "properties": {
                "pos": {
                  "type": "string",
                  "minLength": 1
                },
                "motor": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "fleets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roleMap"
          ],
          "properties": {
            "motorChannels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            },
            "rotorScale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dynamicSpawn": {
              "type": "boolean",
              "default": false
            },
            "templateDroneIndex": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "maxDynamicDrones": {
              "type": "integer",
              "minimum": 1
            },
            "roleMap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "visual_state_array"
              ],
              "properties": {
                "visual_state_array": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "vehicles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roleMap"],
          "properties": {
            "roleMap": {
              "type": "object",
              "additionalProperties": false,
              "required": ["vehicle_states", "joint_states"],
              "properties": {
                "vehicle_states": {
                  "type": "string",
                  "const": "sensor_msgs/MultiDOFJointState"
                },
                "joint_states": {
                  "type": "string",
                  "const": "sensor_msgs/JointState"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "legacy"
              }
            }
          },
          "then": {
            "required": [
              "legacy"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "fleets"
              }
            }
          },
          "then": {
            "required": [
              "fleets"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stateInput": {
            "properties": {
              "mode": {
                "const": "fleets"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "pdu": {
            "required": [
              "wireVersion"
            ],
            "properties": {
              "wireVersion": {
                "const": "v2"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stateInput": { "required": ["vehicles"] }
        }
      },
      "then": {
        "properties": {
          "pdu": {
            "required": ["wireVersion"],
            "properties": { "wireVersion": { "const": "v2" } }
          }
        }
      }
    }
  ]
}
